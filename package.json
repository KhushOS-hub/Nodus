{
  "name": "home-cloud",
  "version": "1.0.0",
  "description": "Self-hosted file server running on Android",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "check": "tsc --noEmit",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate"
  },
  "keywords": [
    "file-server",
    "self-hosted",
    "android",
    "express",
    "typescript"
  ],
  "author": "Khush",
  "license": "ISC",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1"
  }
}